# BizLens AI 容器环境变量模板
# 使用：cp docker/.env.example docker/.env 后按实际环境填写
# 格式必须是纯 KEY=VALUE，不要加 export、不要加引号（脚本与 --env-file 都按此格式解析）
# 该文件（docker/.env）已被 .gitignore 忽略，请勿提交真实口令

# ---- 必填：PostgreSQL ----
# 数据库与容器同一台机器，但容器里的 localhost 是容器自己，必须写域名或内网 IP
DATABASE_URL=jdbc:postgresql://zzzoooo2.top:53309/bizlens
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=change-me

# ---- 必填：Redis（REDIS_PASSWORD 可为空）----
# 按 Redis 实际所在地址填；若与应用不在同一台机器，改成那台的 IP
REDIS_HOST=zzzoooo2.top
REDIS_PORT=6379
REDIS_PASSWORD=

# ---- 强烈建议：密钥（不填会用源码内置的开发密钥，生产环境必须传）----
# AES_KEY 用于加密落库的 Git 访问令牌，JWT_SECRET 用于签发登录态，均建议 32 位以上随机串
AES_KEY=change-me-at-least-32-byte-secret
JWT_SECRET=change-me-at-least-32-byte-jwt-secret

# ---- 可选：语义召回（不启用则只走关键词召回）----
AI_EMBEDDING_ENABLED=false
AI_EMBEDDING_BASE_URL=
AI_EMBEDDING_API_KEY=
AI_EMBEDDING_MODEL=text-embedding-3-small
AI_EMBEDDING_DIMENSION=1536

# ---- 可选：索引克隆的出网代理（默认直连；内网 Git 必须写进 NO_PROXY）----
BIZLENS_GIT_PROXY=
BIZLENS_GIT_NO_PROXY=git.inksdev.com,192.168.99.92,localhost,127.0.0.1

# ---- 可选：追加 java 启动参数，例如改容器端口 ----
# 注意：改了端口要同步改 docker/run.sh 的 CONTAINER_PORT 与 -p 映射
# PARAMS=--server.port=8080

# ---- 镜像仓库参数：build.sh / push.sh / run.sh 与 docker-compose.yml 读这些 ----
# （不是应用配置，不会影响 jar 内配置）
# REGISTRY 必须填你的 Docker Hub 账号名；自建仓库填完整前缀（如 harbor.xxx.com/bizlens）
REGISTRY=
IMAGE=bizlens-ai
# 要拉取的版本标签：回滚时改这里再执行 ./docker/run.sh 即可
TAG=latest
# 宿主机端口（容器内固定 10610）
HOST_PORT=10610
# run.sh 启动完成后打印的访问地址用它；只影响提示文字，不影响容器配置
PUBLIC_HOST=zzzoooo2.top
